#!/usr/bin/env bash
# Run a single command in a lab's backend.
# Usage: lab-run <lab> -- <cmd> [args...]
#        lab-run "" -- <cmd> [args...]   # native: exec locally
#
# Backend derived from the lab name's first letter: h → host, d → docker,
# c → coder. Empty <lab> means "no lab, run here". This is what callers pass
# when the originating pane has no @lab option set.
#
# For coder backends, manages a long-lived ssh ControlMaster whose master
# connection carries `-R /tmp/tmux-1000/default:/tmp/tmux-1000/default` so
# tools inside the workspace can `tmux send-keys` etc. against host tmux
# transparently. Slave connections multiplex over the master and are cheap.
set -euo pipefail
if [[ "${1:-}" == "--help" ]]; then
    echo "Run one command in a lab: h -> host, d -> docker, c -> coder, empty -> here."
    echo "Usage: lab-run <lab> -- <cmd> [args...]"
    exit 0
fi

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# lab-lib.sh sits beside this script once installed; in the repo the tmux and
# script helpers are kept apart, and the private tmux scripts a level further.
for d in "$SCRIPT_DIR" "$SCRIPT_DIR/../scripts" "$SCRIPT_DIR/../public/scripts"; do
    [ -f "$d/lab-lib.sh" ] && { source "$d/lab-lib.sh"; break; }
done
# A miss is otherwise silent: every lab_* call expands to nothing and the caller
# degrades instead of stopping — a pane with no Claude, a recipe on the host.
declare -F lab_resolve >/dev/null || { echo "lab-run: cannot find lab-lib.sh" >&2; exit 1; }

LAB="${1:-}"
shift || true
if [ "${1:-}" = "--" ]; then shift; fi

if [ $# -eq 0 ]; then
    echo "lab-run: no command after --" >&2
    exit 2
fi

if [ -z "$LAB" ]; then
    exec "$@"
fi

lab_resolve "$LAB" || exit 1

case "$LAB_BACKEND" in
    host)
        cd "$LAB_WORKTREE"
        exec "$@"
        ;;
    docker)
        DOCKER_FLAGS=(-i)
        [ -t 0 ] && DOCKER_FLAGS+=(-t)
        DOCKER_FLAGS+=(-e "TERM=${TERM:-xterm-256color}")
        PANE_ID="${TMUX_PANE:-}"
        [ -n "$PANE_ID" ] && DOCKER_FLAGS+=(-e "LAB_PANE_ID=$PANE_ID")
        exec docker exec "${DOCKER_FLAGS[@]}" -w "$LAB_WORKTREE" "$LAB_CONTAINER" "$@"
        ;;
    coder)
        WORKSPACE="$LAB_CONTAINER"
        HOST="$WORKSPACE.coder"
        # Coder workspaces clone the repo at /workspace (set by coder_agent.dir).
        # cd there directly — no host-shape worktree symlink any more.
        WORKDIR="/workspace"
        SSHMUX_DIR="$HOME/.cache/lab-run-sshmux"
        mkdir -p "$SSHMUX_DIR"
        SOCKET="$SSHMUX_DIR/${WORKSPACE}.sock"

        # Establish master if absent. Carries the -R forward and ControlPersist.
        # ServerAlive* self-reaps a wedged master (e.g. wifi flap) in ~10s — else
        # -O check still sees the live master process and slaves hang as blank popups.
        if ! ssh -O check -o "ControlPath=$SOCKET" "$HOST" >/dev/null 2>&1; then
            ssh -fN -o "ControlMaster=yes" -o "ControlPath=$SOCKET" -o "ControlPersist=30m" \
                -o "ServerAliveInterval=5" -o "ServerAliveCountMax=2" \
                -R "/tmp/tmux-1000/default:/tmp/tmux-1000/default" \
                "$HOST"
            # tmux refuses sockets in dirs with mode != 0700. Idempotent.
            ssh -o "ControlPath=$SOCKET" "$HOST" -- \
                'mkdir -p /tmp/tmux-1000 && chmod 700 /tmp/tmux-1000' >/dev/null 2>&1 || true
        fi

        # Quote args for the remote bash -c.
        CMD_STR=""
        for arg in "$@"; do
            CMD_STR="$CMD_STR $(printf %q "$arg")"
        done
        EXT_ENV=""
        PANE_ID="${TMUX_PANE:-}"
        [ -n "$PANE_ID" ] && EXT_ENV="export LAB_PANE_ID='$PANE_ID'; "
        SSH_TTY=()
        [ -t 0 ] && SSH_TTY=(-t)
        exec ssh "${SSH_TTY[@]}" -o "ControlPath=$SOCKET" "$HOST" -- \
            "${EXT_ENV}cd $WORKDIR && exec$CMD_STR"
        ;;
esac
