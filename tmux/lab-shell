#!/usr/bin/env bash
# Open a shell in a lab.
# Backend comes from the name's first letter: h → host, d → docker, c → coder.
# Sets the @lab and @backend tmux pane options so just.sh routes recipe dispatch
# correctly and lab-release.sh knows what the pane is showing.
set -euo pipefail
if [[ "${1:-}" == "--help" ]]; then
    echo "Open a shell in a lab: h -> host, d -> docker, c -> coder."
    echo "Usage: lab-shell [--interactive-after] <lab> [cmd...]"
    exit 0
fi

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# lab-lib.sh sits beside this script once installed; in the repo the tmux and
# script helpers are kept apart, and the private tmux scripts a level further.
for d in "$SCRIPT_DIR" "$SCRIPT_DIR/../scripts" "$SCRIPT_DIR/../public/scripts"; do
    [ -f "$d/lab-lib.sh" ] && { source "$d/lab-lib.sh"; break; }
done
# A miss is otherwise silent: every lab_* call expands to nothing and the caller
# degrades instead of stopping — a pane with no Claude, a recipe on the host.
declare -F lab_resolve >/dev/null || { echo "lab-shell: cannot find lab-lib.sh" >&2; exit 1; }

# --interactive-after: after running the inner cmd, drop into an interactive
# login shell with the cmd recorded in its history (Up-arrow recalls it). Used
# by just.sh's foreground recipe dispatch so the split pane shows what it ran.
INTERACTIVE_AFTER=0
while [ $# -gt 0 ]; do
    case "$1" in
        --interactive-after) INTERACTIVE_AFTER=1; shift ;;
        --) shift; break ;;
        *) break ;;
    esac
done

LAB="${1:-}"
INNER_CMD="${2:-}"
if [ -z "$LAB" ]; then
    echo "usage: lab-shell [--interactive-after] <lab> [inner-cmd]"
    exit 1
fi

# A pane that is meant to stay interactive must not die before it opens: a
# quadrant is @unclosable, so close-pane.sh cannot clear a dead one and the slot
# is lost until the window is rebuilt. Say what failed, drop the tags so just.sh
# stops routing recipes at a lab that is not there, and hand the pane a plain
# host shell with the error sitting above the prompt.
#
# A bare inner command is the exception. That pane is a DISPATCH pane: its
# remain-on-exit is what holds the error, and a shell there would neither run
# the command nor ever close.
degrade_or_exit() {
    echo "lab-shell: $1" >&2
    [ -z "$INNER_CMD" ] || [ "$INTERACTIVE_AFTER" -eq 1 ] || exit 1
    if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
        tmux set-option -pu -t "$TMUX_PANE" @lab 2>/dev/null || true
        tmux set-option -pu -t "$TMUX_PANE" @backend 2>/dev/null || true
    fi
    # Land in the project's main checkout where there is one. Failing to resolve
    # is what leaves no project, so that caller passes none and the pane keeps
    # whatever cwd it was created with.
    [ -n "${2:-}" ] && [ -d "$2" ] && cd "$2"
    exec bash -l
}

lab_resolve "$LAB" || degrade_or_exit "cannot resolve '$LAB'"

# The direnv hook rides on PROMPT_COMMAND, which a non-interactive `bash -lc`
# never runs, so a dispatched recipe would build with none of the lab's .envrc
# (ccache base_dir, max_size). Load it by hand, after any cd into the worktree.
# Stderr stays visible: a blocked .envrc must not fail silently.
DIRENV_LOAD='eval "$(direnv export bash)"; '

# Build the in-backend command for --interactive-after: run the recipe, append
# it verbatim to the history file, then exec an interactive login shell. The
# recipe runs in a non-interactive `bash -lc` whose in-memory history is lost at
# exec, so the seed goes through the history FILE, which the fresh login shell
# reads at startup. HISTFILE is unset in `bash -lc`, so the fallback resolves to
# the same path the interactive shell defaults to. The seed records the bare
# recipe, so the env load never shows up under Up-arrow.
seeded_interactive_cmd() {
    local seed
    seed='printf '\''%s\n'\'' '"$(lab_sq "$1")"' >> "${HISTFILE:-$HOME/.bash_history}"'
    printf 'trap : INT; %s%s; %s; exec bash -l' "$DIRENV_LOAD" "$1" "$seed"
}

if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    tmux set-option -pt "$TMUX_PANE" @lab "$LAB" 2>/dev/null || true
    tmux set-option -pt "$TMUX_PANE" @backend "$LAB_BACKEND" 2>/dev/null || true
fi

# Container busy-check uses LAB_PANE_ID — set to the tmux pane id when present.
PANE_ID_FOR_CONTAINER="${TMUX_PANE:-}"

case "$LAB_BACKEND" in
    host)
        [ -d "$LAB_WORKTREE" ] || degrade_or_exit "no worktree at $LAB_WORKTREE" "$LAB_CHECKOUT"
        cd "$LAB_WORKTREE"
        # No LAB_PANE_ID export: a host lab's processes are ordinary children of
        # the pane, so kill-pane reaps them and lab-cleanup.sh has nothing to do.
        if [ -n "$INNER_CMD" ] && [ "$INTERACTIVE_AFTER" -eq 1 ]; then
            exec bash -lc "$(seeded_interactive_cmd "$INNER_CMD")"
        elif [ -n "$INNER_CMD" ]; then
            exec bash -lc "$DIRENV_LOAD$INNER_CMD"
        else
            exec bash -l
        fi
        ;;
    docker)
        CONTAINER="$LAB_CONTAINER"
        # Use the host-shaped path so claude keys per-project state under the
        # same encoded cwd as host runs (~/.claude/projects/-home-...).
        WORKDIR="$LAB_WORKTREE"

        if ! docker container inspect "$CONTAINER" >/dev/null 2>&1; then
            degrade_or_exit "container $CONTAINER does not exist" "$LAB_CHECKOUT"
        fi
        if [ "$(docker container inspect -f '{{.State.Running}}' "$CONTAINER")" != "true" ]; then
            docker start "$CONTAINER" >/dev/null \
                || degrade_or_exit "cannot start container $CONTAINER" "$LAB_CHECKOUT"
        fi

        DOCKER_ENV=(-e "TERM=${TERM:-xterm-256color}")
        # Propagate the multiplexer pane id so just.sh can detect busy
        # panes by counting in-container processes that inherited it.
        if [ -n "$PANE_ID_FOR_CONTAINER" ]; then
            DOCKER_ENV+=(-e "LAB_PANE_ID=$PANE_ID_FOR_CONTAINER")
        fi
        if [ -n "$INNER_CMD" ] && [ "$INTERACTIVE_AFTER" -eq 1 ]; then
            exec docker exec -it "${DOCKER_ENV[@]}" -w "$WORKDIR" "$CONTAINER" \
                bash -lc "$(seeded_interactive_cmd "$INNER_CMD")"
        elif [ -n "$INNER_CMD" ]; then
            exec docker exec -it "${DOCKER_ENV[@]}" -w "$WORKDIR" "$CONTAINER" bash -lc "$DIRENV_LOAD$INNER_CMD"
        else
            exec docker exec -it "${DOCKER_ENV[@]}" -w "$WORKDIR" "$CONTAINER" bash -l
        fi
        ;;
    coder)
        WORKSPACE="$LAB_CONTAINER"
        # Coder workspaces clone the repo at /workspace (set by coder_agent.dir).
        # cd there directly — no host-shape worktree symlink any more.
        EXT_ENV=""
        [ -n "$PANE_ID_FOR_CONTAINER" ] && EXT_ENV="export LAB_PANE_ID='$PANE_ID_FOR_CONTAINER'; "
        WORKDIR="/workspace"
        # coder ssh space-joins remote argv without re-quoting, so a bare
        # `bash -lc "<script>"` gets mangled — bash -lc grabs only the first
        # word and the LAB_PANE_ID export is silently dropped. Pre-quote each
        # token so the workspace shell re-parses it into the original words.
        cq() { local a out=""; for a in "$@"; do out+=" $(lab_sq "$a")"; done; printf '%s' "$out"; }
        if [ -n "$INNER_CMD" ] && [ "$INTERACTIVE_AFTER" -eq 1 ]; then
            exec coder ssh "$WORKSPACE" -- "$(cq bash -lc "${EXT_ENV}cd $WORKDIR && $(seeded_interactive_cmd "$INNER_CMD")")"
        elif [ -n "$INNER_CMD" ]; then
            exec coder ssh "$WORKSPACE" -- "$(cq bash -lc "${EXT_ENV}cd $WORKDIR && $DIRENV_LOAD$INNER_CMD")"
        else
            exec coder ssh "$WORKSPACE" -- "$(cq bash -lc "${EXT_ENV}cd $WORKDIR && exec bash -l")"
        fi
        ;;
esac
